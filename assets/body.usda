#usda 1.0
(
    defaultPrim = "Body"
    metersPerUnit = 1
    upAxis = "Y"
)

def Xform "Body" (
    variants = {
        string paint = "gloss_white"
    }
    prepend variantSets = "paint"
)
{
    def Cube "Shell"
    {
        double size = 1
        float3 xformOp:scale = (4.2, 1.3, 1.8)
        uniform token[] xformOpOrder = ["xformOp:scale"]
    }

    def "Materials"
    {
        def Material "gloss_white"
        {
            token outputs:surface.connect = </Body/Materials/gloss_white/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                float inputs:clearcoat = 0.9
                float inputs:clearcoatRoughness = 0.03
                color3f inputs:diffuseColor = (0.9, 0.9, 0.9)
                float inputs:metallic = 0
                float inputs:roughness = 0.15
                token outputs:surface
            }
        }

        def Material "racing_blue"
        {
            token outputs:surface.connect = </Body/Materials/racing_blue/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                float inputs:clearcoat = 0.9
                float inputs:clearcoatRoughness = 0.05
                color3f inputs:diffuseColor = (0.05, 0.2, 0.65)
                float inputs:metallic = 0
                float inputs:roughness = 0.2
                token outputs:surface
            }
        }

        def Material "matte_black"
        {
            token outputs:surface.connect = </Body/Materials/matte_black/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                float inputs:clearcoat = 0
                float inputs:clearcoatRoughness = 0.5
                color3f inputs:diffuseColor = (0.06, 0.06, 0.07)
                float inputs:metallic = 0
                float inputs:roughness = 0.75
                token outputs:surface
            }
        }
    }
    variantSet "paint" = {
        "gloss_white" {
            over "Shell" (
                prepend apiSchemas = ["MaterialBindingAPI"]
            )
            {
                rel material:binding = </Body/Materials/gloss_white>
                color3f[] primvars:displayColor = [(0.9, 0.9, 0.9)]
            }

        }
        "matte_black" {
            over "Shell" (
                prepend apiSchemas = ["MaterialBindingAPI"]
            )
            {
                rel material:binding = </Body/Materials/matte_black>
                color3f[] primvars:displayColor = [(0.06, 0.06, 0.07)]
            }

        }
        "racing_blue" {
            over "Shell" (
                prepend apiSchemas = ["MaterialBindingAPI"]
            )
            {
                rel material:binding = </Body/Materials/racing_blue>
                color3f[] primvars:displayColor = [(0.05, 0.2, 0.65)]
            }

        }
    }
}

