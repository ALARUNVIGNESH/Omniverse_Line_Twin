#usda 1.0
(
    defaultPrim = "Body"
    metersPerUnit = 1
    upAxis = "Y"
)

def Xform "Body" (
    variants = {
        string paint = "gloss_white"
    }
    prepend variantSets = "paint"
)
{
    def Cube "Shell"
    {
        double size = 1
        float3 xformOp:scale = (4.2, 1.3, 1.8)
        uniform token[] xformOpOrder = ["xformOp:scale"]
    }
    variantSet "paint" = {
        "gloss_white" {
            over "Shell"
            {
                color3f[] primvars:displayColor = [(0.9, 0.9, 0.9)]
            }

        }
        "matte_black" {
            over "Shell"
            {
                color3f[] primvars:displayColor = [(0.06, 0.06, 0.07)]
            }

        }
        "racing_blue" {
            over "Shell"
            {
                color3f[] primvars:displayColor = [(0.05, 0.2, 0.65)]
            }

        }
    }
}

